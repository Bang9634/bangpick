digraph StorageBoundary {
  graph [rankdir=TB, bgcolor="white", pad=0.45, nodesep=0.65, ranksep=0.65,
    label="bangpick | 스토리지 의존성 경계\n백엔드 코드 구조 · 2026-11-16", labelloc=t, labeljust=l,
    fontsize=23, fontcolor="#0f172a"];
  node [shape=box, style="rounded,filled", color="#cbd5e1", fillcolor="#f8fafc",
    fontcolor="#0f172a", fontsize=13, margin="0.23,0.18", penwidth=1.2];
  edge [color="#64748b", fontcolor="#475569", fontsize=11, arrowsize=0.8, penwidth=1.3];

  usecase [label="MediaJobs\n작업 상태 · 전송 허가 요청", fillcolor="#f0fdfa", color="#2dd4bf"];
  port [label="MediaStorage\n권한 발급·회수 / 객체 크기 확인", fillcolor="#eff6ff", color="#60a5fa"];
  oci [label="OciMediaStorage\nOCI SDK · 예외 변환", fillcolor="#fff7ed", color="#fb923c"];
  cloud [label="OCI Object Storage\n비공개 버킷 · 객체별 임시 URL", fillcolor="#fff7ed", color="#fb923c"];
  note [shape=plain, fontsize=12, fontcolor="#475569",
    label="공급자 교체 시 작업 로직은 동일한 인터페이스를 사용"];

  usecase -> port [label="의존 / 호출"];
  oci -> port [label="구현", style=dashed, arrowhead=empty, constraint=false];
  port -> oci [style=invis];
  oci -> cloud [label="공급자 API 호출"];
  cloud -> note [style=invis];
}
