digraph ReconstructionFlow {
  graph [rankdir=TB, bgcolor="white", pad=0.4, nodesep=0.55, ranksep=0.5,
    label="bangpick | 업로드부터 투어 공개까지\n목표 설계 · 2026-11-12", labelloc=t, labeljust=l,
    fontsize=23, fontcolor="#0f172a"];
  node [shape=box, style="rounded,filled", color="#cbd5e1", fillcolor="#f8fafc",
    fontcolor="#0f172a", fontsize=13, margin="0.23,0.15", penwidth=1.2];
  edge [color="#64748b", fontcolor="#475569", fontsize=11, arrowsize=0.8, penwidth=1.3];

  request [label="01  등록자 → 백엔드\n매물 등록 · 업로드 허가 요청", fillcolor="#eff6ff", color="#60a5fa"];
  upload [label="02  브라우저 → 스토리지\n제한된 권한으로 원본 직접 업로드"];
  verify [label="03  백엔드\n업로드 완료 확인 · 객체 검증\n확인된 입력으로 작업 등록", fillcolor="#f0fdfa", color="#2dd4bf"];
  process [label="04  GPU Worker\n작업 점유 · 입력 다운로드\n전처리 → 학습 → 후처리", fillcolor="#faf5ff", color="#c084fc"];
  result [label="05  Worker → 스토리지 / 백엔드\n결과 묶음 업로드 · 완료 보고\n모델 + 이동 제한 데이터 + 미리보기"];
  review [label="06  검수\n모델·뷰어·이동 제한 확인\n학습 완료와 공개 상태 분리", fillcolor="#fff7ed", color="#fb923c"];
  publish [label="07  백엔드\n승인된 결과 버전을 투어에 연결", fillcolor="#f0fdfa", color="#2dd4bf"];
  viewer [label="08  방문자 브라우저\n공개 결과 조회 · 3D 탐색\n허용된 영역 안에서 이동", fillcolor="#eff6ff", color="#60a5fa"];
  retry [label="처리 실패\n오류 기록 · 재시도 가능 여부 판단\n미완성 결과는 공개하지 않음", fillcolor="#fff1f2", color="#fda4af", fontsize=12];
  rejected [label="검수 반려\n원인 확인 후 수정·재처리\n미검수 결과는 공개하지 않음", fillcolor="#fff1f2", color="#fda4af", fontsize=12];
  retention [label="원본 보관 정책\n검수 승인 시각부터 7일 후 삭제\n최종 투어 파일은 유지", fillcolor="#fff7ed", color="#fb923c", fontsize=12];

  request -> upload [label="권한 확인 · 접근 수단 발급"];
  upload -> verify [label="완료 통보 후 실제 객체 확인"];
  verify -> process [label="대기 작업을 Worker가 가져감"];
  process -> result [label="처리 성공"];
  process -> retry [label="실패", style=dashed, constraint=false];
  result -> review [label="결과 파일 확인"];
  review -> rejected [label="반려", style=dashed, constraint=false];
  review -> publish [label="승인 · 공개"];
  review -> retention [label="승인 시각 기준", style=dashed, constraint=false];
  publish -> viewer [label="모델·이동 제한 데이터를 함께 로드"];
  {rank=same; process; retry;}
  {rank=same; review; rejected;}
  {rank=same; publish; retention;}
}
