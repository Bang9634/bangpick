digraph SystemOverview {
  graph [layout=neato, overlap=true, splines=line, outputorder=edgesfirst,
    bgcolor="white", pad=0.38, labelloc=t, labeljust=l, fontcolor="#0f172a",
    label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="25">bangpick | 전체 시스템 구성</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#475569">투어 설계</FONT></TD></TR>
    </TABLE>>];
  node [shape=box, style="rounded,filled", color="#cbd5e1", fillcolor="#f8fafc",
    fontcolor="#0f172a", fontsize=15, margin="0.22,0.15", penwidth=1.3];
  edge [color="#64748b", arrowsize=0.8, penwidth=1.45];

  browser [pos="4.9,5.8!", label="사용자 브라우저\nReact 화면 · 3D 뷰어", fillcolor="#eff6ff", color="#60a5fa"];
  web [pos="2.15,4.35!", label="웹 서버 · Docker\n정적 화면 제공 · API 프록시"];
  backend [pos="2.15,2.75!", label="Java 백엔드 · Docker\nGoogle 로그인 · 권한 · 매물 · 작업", fillcolor="#f0fdfa", color="#2dd4bf"];
  db [pos="2.15,1.0!", label="MySQL\n회원·매물·작업·자산 메타데이터"];
  storage [pos="7.85,3.25!", label="오브젝트 스토리지\n원본 영상 · 투어 결과 파일", fillcolor="#fff7ed", color="#fb923c"];
  worker [pos="7.85,1.0!", label="독립 GPU Worker\n전처리 → 3DGS 학습 → 후처리", fillcolor="#faf5ff", color="#c084fc"];

  browser -> web;
  web -> backend;
  backend -> db;
  backend -> storage;
  browser -> storage [color="#b45309"];
  worker -> backend;
  worker -> storage [color="#b45309"];

  node [shape=box, width=0, height=0, style=filled, fillcolor="white", color="white",
    fontcolor="#475569", margin="0.045,0.015", fontsize=12];
  browser_api [pos="2.95,5.35!", label="화면·API 요청"];
  front_direct [pos="7.65,4.96!", label="직접 전송 · 영상 PUT / 투어 GET", fontcolor="#92400e"];
  proxy [pos="2.93,3.55!", label="API 요청 전달"];
  db_access [pos="3.51,1.86!", label="메타데이터 읽기·쓰기"];
  storage_access [pos="4.95,3.29!", label="임시 URL 발급 · 객체 확인"];
  worker_report [pos="5.25,2.29!", label="작업 점유 · 결과 보고"];
  worker_direct [pos="8.76,2.14!", label="원본 GET\n결과 PUT", fontcolor="#92400e"];
  legend [pos="4.9,0.27!", label="화살표: 요청을 보내는 쪽 → 대상  ·  이미 등록된 결과 조회에는 Worker가 필요하지 않음"];
}
