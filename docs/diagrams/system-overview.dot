digraph SystemOverview {
  graph [rankdir=TB, bgcolor="white", pad=0.45, nodesep=0.6, ranksep=0.7,
    label="bangpick | 전체 시스템 구성\n목표 설계 · 2026-11-12", labelloc=t, labeljust=l,
    fontsize=23, fontcolor="#0f172a", compound=true, newrank=true];
  node [shape=box, style="rounded,filled", color="#cbd5e1", fillcolor="#f8fafc",
    fontcolor="#0f172a", fontsize=13, margin="0.23,0.17", penwidth=1.2];
  edge [color="#64748b", fontcolor="#475569", fontsize=11, arrowsize=0.8, penwidth=1.3];

  browser [label="사용자 브라우저\nReact 화면 · 3D 뷰어\nWASD / 마우스 탐색", fillcolor="#eff6ff", color="#60a5fa"];

  subgraph cluster_web {
    label="웹 실행 환경 · Docker"; fontsize=15; color="#cbd5e1"; style=rounded; margin=22;
    web [label="웹 서버\n정적 화면 제공\nAPI 프록시"];
    backend [label="Java 백엔드\n권한 · 매물 · 작업 · 검수\n파일 접근 허가", fillcolor="#f0fdfa", color="#2dd4bf"];
    web -> backend [label="API 요청"];
  }
  db [label="MySQL\n매물 / 작업 / 자산 메타데이터\n영상·모델 본문은 저장하지 않음"];
  storage [label="오브젝트 스토리지\n원본 영상 / 투어 결과 파일\n접근 범위 구분\nOCI 우선 후보 · 공급자 교체 고려", fillcolor="#fff7ed", color="#fb923c"];
  subgraph cluster_gpu {
    label="독립 GPU 실행 환경 · Docker"; fontsize=15; color="#cbd5e1"; style=rounded; margin=22;
    worker [label="Python GPU Worker\n전처리 → 3DGS 학습 → 후처리\n필요할 때 가동", fillcolor="#faf5ff", color="#c084fc"];
  }

  browser -> web [label="화면 / API 요청"];
  backend -> db [label="메타데이터 읽기·쓰기"];
  backend -> storage [label="접근 허가 / 객체 확인·관리"];
  browser -> storage [label="허가받은 직접 전송\n영상 PUT / 투어 GET", color="#d97706", fontcolor="#92400e"];
  worker -> backend [label="작업 점유 / 상태·결과 보고", constraint=false];
  worker -> storage [label="입력 다운로드 / 결과 업로드", color="#9333ea", fontcolor="#7e22ce"];
  {rank=same; db; worker; storage;}

  legend [shape=plain, fontsize=11, fontcolor="#64748b",
    label="화살표: 요청을 시작하는 쪽 → 대상 (응답 생략)\nWorker가 꺼져도 공개된 투어 파일은 조회 가능\n목표 구조 · 구현 상태는 개발 안내 참조"];
  storage -> legend [style=invis];
}
