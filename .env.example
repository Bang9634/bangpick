# Local development only. Replace both passwords before starting.
DB_NAME=bangpick
DB_USERNAME=bangpick
DB_PASSWORD=replace-with-local-app-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password

WEB_PORT=8088
API_PORT=8080
DB_PORT=13306

# Optional: Google web application OAuth client. Use the address opened
# in the browser. Vite and Compose both default to port 8088.
BANGPICK_AUTH_ENABLED=false
BANGPICK_WEB_ORIGIN=http://localhost:8088
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: OCI file transfers with the backend running locally via Maven.
# Use a development token only when Google login is disabled. Keep the Worker
# token separate; the optional recovery token is for operators only.
BANGPICK_MEDIA_ENABLED=false
BANGPICK_MEDIA_DEV_TOKEN=
BANGPICK_MEDIA_WORKER_TOKEN=
BANGPICK_MEDIA_RECOVERY_TOKEN=
OCI_NAMESPACE=
OCI_BUCKET=bangpick-dev
OCI_REGION=
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=BANGPICK_DEV
